      "type": "text",
      "x": -386.2638284830332,
      "y": 3416.932654316336,
      "width": 2272.23095703125,
      "height": 200.69366486864686,
      "angle": 0,
      "strokeColor": "#f08c00",
      "backgroundColor": "#ffffff",
